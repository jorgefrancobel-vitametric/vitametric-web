#!/bin/sh
# Reescribe los ?v= de css/js con el hash de contenido y re-agrega los HTML tocados.
# Sin esto, editar un CSS sin cambiar la URL deja el cambio invisible hasta 4h en el
# navegador del visitante (GitHub Pages sirve max-age=14400 y no respeta _headers).
# Activar una sola vez con:  git config core.hooksPath .githooks
set -e
repo="$(git rev-parse --show-toplevel)"
cd "$repo"

# ── Red de seguridad: HTML bienformado ────────────────────────────────────
# Un <div> sin cerrar (d2603c1) anidó medio documento dentro del overlay y
# dejó ozonoterapia en blanco en móvil ~2 meses. Aquí y en html-validate.yml
# (CI) se valida antes de que el HTML llegue a main y a producción.
html_tocados="$(
  { git diff --cached --name-only --diff-filter=ACM -- '*.html'
    git diff --name-only --diff-filter=ACM -- '*.html'; } | sort -u
)"
if [ -n "$html_tocados" ]; then
  set --
  while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$f" ] && set -- "$@" "$f"
  done <<EOF
$html_tocados
EOF
  if [ "$#" -gt 0 ] && ! python3 "$repo/scripts/check-html-balance.py" "$@"; then
    echo "✗ pre-commit: HTML malformado (tags sin cerrar / cierres huérfanos)." >&2
    echo "  Corrige los archivos listados arriba antes de commitear." >&2
    exit 1
  fi
fi

python3 "$repo/scripts/bump-cache.py" >/dev/null
cd "$repo"
git diff --name-only -- '*.html' | while read -r f; do
  [ -n "$f" ] && git add "$f"
done
exit 0
